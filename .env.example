# Database connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/wans_db?schema=public"

# Auth Secrets
JWT_SECRET="your-ultra-secure-random-jwt-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Discord OAuth & Rich Presence
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# Spotify Web API
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/integrations/spotify/callback"

# Optional Cloud Storage (S3 / Cloudflare R2 / Supabase Storage)
STORAGE_PROVIDER="local" # local, s3, r2
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
